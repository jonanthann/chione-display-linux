[Unit]
Description=Gamdias Chione E4 temperature display (real CPU temp via hwmon)

[Service]
# The script auto-discovers both the cooler (by USB ID) and the CPU sensor
# (by hwmon driver name), so nothing here needs editing for AMD vs Intel.
#
# The one path that does: this assumes the repo was cloned into your home
# directory as ~/chione-display-linux. If you cloned it elsewhere, either
# fix the path below or let `./install.sh service` generate this unit with
# the real path.
#
# If the repo lives on a removable or late-mounting disk, prefer
# `./install.sh service`: the unit it generates skips the start quietly
# (ConditionPathExists) while the disk is missing. This file leaves that out
# on purpose, so a wrong path above fails loudly instead of doing nothing.
ExecStart=/usr/bin/python3 %h/chione-display-linux/chione_temp_display.py
Restart=on-failure
RestartSec=5
# Stop retrying on permanent misconfiguration (exit code 2): bad arguments, or
# no matching hwmon sensor after the ~60s startup wait. (A missing device permission is retried, not fatal.) Fix the cause, then
# `systemctl --user restart chione-temp.service`.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
